# FFNodes Client - Environment Variables Example
# Copy this file to .env and fill in your OAuth credentials

# ============================================
# OAuth Client IDs (Frontend - Safe to expose)
# ============================================

# Google OAuth
# Get from: https://console.cloud.google.com/
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# GitHub OAuth
# Get from: https://github.com/settings/developers
VITE_GITHUB_CLIENT_ID=your_github_client_id_here

# Microsoft OAuth
# Get from: https://portal.azure.com/ -> App registrations
VITE_MICROSOFT_CLIENT_ID=your_microsoft_client_id_here

# Facebook OAuth
# Get from: https://developers.facebook.com/apps/
VITE_FACEBOOK_CLIENT_ID=your_facebook_app_id_here

# ============================================
# OAuth Client Secrets (Backend - Keep secure!)
# ============================================

# Google OAuth Secret
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# GitHub OAuth Secret
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Microsoft OAuth Secret
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret_here

# Facebook OAuth Secret
FACEBOOK_CLIENT_SECRET=your_facebook_app_secret_here

# ============================================
# Notes
# ============================================
#
# 1. Variables with VITE_ prefix are exposed to the frontend
# 2. Client secrets (without VITE_) are only used in Rust backend
# 3. See OAUTH_SETUP.md for detailed instructions on getting these credentials
# 4. Add .env to .gitignore to prevent committing secrets
# 5. OAuth is optional - app works with "Display Name" login without these
